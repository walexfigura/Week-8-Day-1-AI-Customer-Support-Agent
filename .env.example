# Copy this file to `.env` and fill in values. `.env` is git-ignored — never commit it.

# --- Required for model-backed commands (demo, eval, webhook) ---------------
OPENAI_API_KEY=

# Model used for the agent. Any OpenAI model that supports function calling in
# the Responses API works. Default: gpt-5.4-mini (fast and inexpensive).
OPENAI_MODEL=gpt-5.4-mini

# Reasoning effort for reasoning models: none, low, medium, high.
# Set to "none" if you choose a model that does not support reasoning.
OPENAI_REASONING_EFFORT=low

# --- Agent limits ------------------------------------------------------------
AGENT_MAX_ITERATIONS=10
AGENT_MAX_TOOL_CALLS=20

# --- Data backend --------------------------------------------------------------
# "mock" uses the fictional JSON files in data/ (default).
# "live" uses the Shopify/Zendesk adapters below (untested; see docs/).
SUPPORT_BACKEND=mock

# The mock datasets describe the world as of 2026-11-10. Keep this fixed so
# scenarios stay deterministic, or set to "now" to use the real clock.
NORTHSTAR_REFERENCE_DATE=2026-11-10

# --- Live Shopify (only if SUPPORT_BACKEND=live) ---------------------------------
# Custom app Admin API access token with read_orders, read_products,
# read_fulfillments, read_customers scopes.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-10

# --- Live Zendesk (only if SUPPORT_BACKEND=live) ---------------------------------
ZENDESK_SUBDOMAIN=your-subdomain
ZENDESK_EMAIL=agent@your-company.example
ZENDESK_API_TOKEN=
# Signing secret from your Zendesk webhook. If empty, the local simulator uses a demo secret.
ZENDESK_WEBHOOK_SECRET=
